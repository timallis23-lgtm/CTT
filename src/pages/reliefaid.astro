---
import Layout from '../layouts/Layout.astro';
---

<Layout title="ReliefAid | Community Transformation Trust" description="In 2023 CT Trust donated $10,000 NZD to ReliefAid to support their emergency relief work in Gaza, providing safe drinking water, ready-made meals, and food kits to displaced families.">
  <div class="report-banner-wrap">
    <img class="report-banner" src="/images/projects/reliefaid-gaza.png" alt="" loading="eager" />
  </div>
  <article class="wrap report-article">
    <h1>ReliefAid</h1>
    <div class="detail-meta"><span>2023</span><span>Gaza</span></div>

    <section class="reveal">
      <h3>ReliefAid in Gaza</h3>
      <p>In 2023 CT Trust donated $10,000 NZD to ReliefAid, to support their emergency relief work in Gaza. ReliefAid is a New Zealand charity providing safe drinking water, ready-made meals and food kits directly to displaced families in Gaza. ReliefAid&rsquo;s team prepares meals in a temporary kitchen, packages them, and delivers them to displaced families. Water is also provided to families in refugee centers.</p>
    </section>
  </article>
</Layout>
