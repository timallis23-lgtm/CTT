---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Donate | Community Transformation Trust" description="Support community-led transformation projects with a one-off or regular donation to Community Transformation Trust.">
  <div class="subpage">
    <section class="subpage-hero">
      <div class="wrap">
        <h1>Make a Donation</h1>
      </div>
    </section>

    <section class="subpage-body">
      <div class="wrap donation-grid reveal">
        <div class="donation-copy">
          <h2 class="sub-h">Help fund lasting change</h2>
          <p class="sub-p">Every donation helps Community Transformation Trust support community-led work that improves water, food, health, education, income, and sanitation in places where poverty is most entrenched.</p>
          <p class="sub-p">All donations to Community Transformation Trust are tax-deductible in New Zealand, and we welcome both one-off gifts and regular support for ongoing projects.</p>
          <div class="donation-cta-row">
            <a href="mailto:david@betterworld.nz?subject=Donation%20enquiry" class="btn-donate">Email to donate</a>
            <a href="/about" class="btn-read-more">Learn about our work</a>
          </div>
        </div>

        <div class="donation-card">
          <img src="/images/donation-illustration.svg" alt="Community-led development illustration" loading="eager" />
          <div class="donation-card__body">
            <h3>How your gift helps</h3>
            <ul>
              <li>Funds clean water and sanitation projects</li>
              <li>Supports education, nutrition and wellness</li>
              <li>Strengthens income-generating opportunities</li>
              <li>Builds community-led resilience for the long term</li>
            </ul>
          </div>
        </div>
      </div>
    </section>

    <section class="donate-band">
      <div class="wrap donation-options">
        <article class="donation-option reveal">
          <h4>One-off gifts</h4>
          <p>Make a single contribution to support an urgent need, a specific region, or a current project.</p>
        </article>
        <article class="donation-option reveal">
          <h4>Regular giving</h4>
          <p>Provide consistent support so communities can plan ahead and build momentum over time.</p>
        </article>
        <article class="donation-option reveal">
          <h4>Project-specific support</h4>
          <p>Give to a particular area of work such as water, food security, education, or income generation.</p>
        </article>
      </div>
    </section>
  </div>
</Layout>
